# Python bytecode and tool caches
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.hypothesis/
.tox/
.nox/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.py.cover

# Virtual environments and local Python installations
.venv/
venv/
env/
ENV/
__pypackages__/
.python-version.local

# Builds and packages
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
MANIFEST

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
.env.*
!.env.example
config/local.yml
*.pem
*.key
*.p12
*.pfx

# LIM runtime state. Keep only the committed directory placeholders.
runtime/**
!runtime/data/
!runtime/jobs/
!runtime/logs/
!runtime/backups/
!runtime/data/.gitkeep
!runtime/jobs/.gitkeep
!runtime/logs/.gitkeep
!runtime/backups/.gitkeep

# Compatibility with historical top-level runtime paths
data/*
logs/*
backups/*
!data/.gitkeep
!logs/.gitkeep
!backups/.gitkeep

# SQLite databases and sidecar files
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# SSH credentials and trust state
ssh/*
!ssh/.gitkeep
known_hosts

# Container-local overrides
docker-compose.override.yml
