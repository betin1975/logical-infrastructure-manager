"""LIM application startup entry point."""

import sys

from .composition import CompositionError, build_application_services
from app.config import ConfigManagerj

def main() -> int:
    """Initialize the composed LIM foundation services without remote actions."""
    try:
        services = build_application_services()
    except CompositionError as exc:
        sys.stderr.write(f"LIM startup failed during {exc.stage}\n")
        return 1

    services.logging_manager.get_logger("bootstrap", operation="startup").info(
        "LIM startup foundation initialized with schema_version=%d "
        "ssh_initialized=true bootstrap_initialized=true polling_initialized=true",
        services.migration_state.schema_version,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
