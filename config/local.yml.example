# Copy this file to config/local.yml for machine-specific, non-secret settings.
# Prefer environment variables or a future secret provider for credentials.

app:
  environment: development

logging:
  level: INFO
  console_enabled: true
  file_enabled: true

# SQLite policy overrides. Keep the database inside paths.data.
database:
  busy_timeout_ms: 5000
  connection_timeout_seconds: 5.0
  journal_mode: WAL
  synchronous_mode: NORMAL

# SSH credential paths may be overridden, but key material never belongs here.
# The configured files must be mounted read-only.
# ssh:
#   admin_private_key: /run/secrets/lim_admin_ed25519
#   monitor_private_key: /run/secrets/monitor_ed25519

# bootstrap:
#   # Public key only; private identities remain under the ssh section.
#   monitor_public_key: /run/secrets/lim_monitor_public_key
#   monitor_username: monitor
#   monitor_home: /var/lib/monitor
